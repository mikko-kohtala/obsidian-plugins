{
	"name": "web-clipper-verifier",
	"version": "1.0.0",
	"description": "Verify that Obsidian Web Clipper content is complete by comparing against the original source URL.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^16.11.6",
		"esbuild": "0.25.5",
		"tslib": "2.4.0",
		"typescript": "^5.8.3"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "^3.0.45",
		"@ai-sdk/google": "^3.0.29",
		"@ai-sdk/moonshotai": "^2.0.5",
		"@mozilla/readability": "^0.5.0",
		"ai": "^6.0.91",
		"linkedom": "^0.18.9",
		"obsidian": "latest"
	}
}
