{
	"name": "fix-markdown",
	"version": "1.0.0",
	"description": "Fix a clipped note with one click: runs the vault's fix-markdown-file skill through the local Claude Code CLI.",
	"keywords": [
		"claude",
		"markdown",
		"obsidian"
	],
	"license": "MIT",
	"type": "module",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt -c .oxfmtrc.jsonc .",
		"format:check": "oxfmt -c .oxfmtrc.jsonc --check .",
		"typecheck": "tsc --noEmit -skipLibCheck",
		"fix": "bun run lint:fix && bun run format",
		"check": "oxlint --deny-warnings && oxfmt -c .oxfmtrc.jsonc --check . && tsc --noEmit -skipLibCheck",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"devDependencies": {
		"@types/node": "^24.19.0",
		"esbuild": "0.28.2",
		"obsidian": "latest",
		"oxfmt": "0.70.0",
		"oxlint": "1.85.0",
		"tslib": "2.8.1",
		"typescript": "^7.0.2"
	},
	"packageManager": "bun@1.4.2",
	"trustedDependencies": [
		"esbuild"
	]
}
