{
	"name": "html-viewer",
	"version": "1.0.2",
	"description": "View local .html and .htm files in Obsidian with sandboxed rendering, source mode, embeds, and trusted local app controls.",
	"keywords": [
		"html",
		"obsidian",
		"viewer"
	],
	"license": "MIT",
	"type": "module",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt -c .oxfmtrc.jsonc .",
		"format:check": "oxfmt -c .oxfmtrc.jsonc --check .",
		"typecheck": "tsc --noEmit -skipLibCheck",
		"fix": "bun run lint:fix && bun run format",
		"check": "oxlint --deny-warnings && oxfmt -c .oxfmtrc.jsonc --check . && tsc --noEmit -skipLibCheck"
	},
	"devDependencies": {
		"@types/node": "^24.13.6",
		"esbuild": "0.28.2",
		"obsidian": "latest",
		"oxfmt": "0.70.0",
		"oxlint": "1.85.0",
		"tslib": "2.8.1",
		"typescript": "^7.0.2"
	},
	"packageManager": "bun@1.4.2",
	"trustedDependencies": [
		"esbuild"
	]
}
